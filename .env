# Entorno por defecto para desarrollo local
VITE_ENVIRONMENT=development

# API base que consumen el sitio público y el panel admin
VITE_API_URL=http://localhost:4000/api

# Nombre de la marca utilizado en encabezados/metadatos
VITE_APP_NAME=Turnapp

# Flag genérico para habilitar integraciones opcionales (ej. analytics)
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# URL base del sitio público (útil para generar links desde el admin)
VITE_PUBLIC_SITE_URL=http://localhost:5173
