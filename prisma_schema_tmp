// Prisma schema draft for Turnapp

enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MERCADO_PAGO
  OTHER
}

enum BookingSource {
  PUBLIC_SITE
  ADMIN_PANEL
  WHATSAPP
  OTHER
}

enum ContentBlockType {
  HERO
  CTA
  METRIC
  FAQ
  TESTIMONIAL
  SERVICE_HIGHLIGHT
  CUSTOM
}

enum ContentBlockStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentBlockVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MetricPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MetricName {
  BOOKINGS_CONFIRMED
  BOOKINGS_CANCELLED
  BOOKINGS_NO_SHOW
  BOOKINGS_COMPLETED
  BOOKING_ATTENDANCE_RATE
  REVENUE_TOTAL
  REVENUE_AVERAGE_TICKET
  REVENUE_BY_SERVICE
  REVENUE_BY_STAFF
  STAFF_UTILIZATION
  STAFF_RATING_AVERAGE
  STAFF_TOP_PERFORMERS
}

enum TwoFactorMethodType {
  TOTP
  SMS
  EMAIL
  RECOVERY_CODES
}

enum BranchContentAudience {
  PUBLIC
  PRIVATE
}

enum StaffAssignmentType {
  PRIMARY
  SECONDARY
}

enum ScheduleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?
  priceCents     Int
  currency       String   @default("ARS")
  billingPeriod  String   @default("monthly")
  maxBranches    Int?
  maxStaff       Int?
  maxServices    Int?
  maxBookings    Int?
  features       PlanFeature[]
  businesses     Business[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PlanFeature {
  id          String @id @default(uuid())
  planId      String
  key         String
  enabled     Boolean @default(true)
  limitValue  Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Business {
  id            String           @id @default(uuid())
  name          String
  legalName     String?
  taxId         String?
  email         String?
  phone         String?
  planId        String
  planStartedAt DateTime @default(now())
  planEndsAt    DateTime?
  active        Boolean  @default(true)
  address       String?
  city          String?
  state         String?
  country       String?
  websiteUrl    String?
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan        Plan           @relation(fields: [planId], references: [id])
  branches    Branch[]
  users       BusinessUser[]
  metrics     BranchMetric[]
}

model BusinessUser {
  id          String   @id @default(uuid())
  businessId  String
  userId      String
  role        UserRole
  isOwner     Boolean  @default(false)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, userId])
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  username          String?            @unique
  passwordHash      String?
  role              UserRole           @default(STAFF)
  displayName       String?
  phone             String?
  avatarUrl         String?
  locale            String?            @default("es-AR")
  timezone          String?            @default("America/Argentina/Buenos_Aires")
  twoFactorEnabled  Boolean            @default(false)
  status            String             @default("active")
  lastLoginAt       DateTime?
  passwordUpdatedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  businessAccess BusinessUser[]
  branchStaff    BranchStaff[]
  mfaMethods     UserMfaMethod[]
  sessions       UserSession[]
  bookings       Booking[]       @relation("BookingCreator")
  bookingEvents  BookingAudit[]
}

model UserSession {
  id            String   @id @default(uuid())
  userId        String
  tokenHash     String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastActiveAt  DateTime?
  metadata      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model UserMfaMethod {
  id           String              @id @default(uuid())
  userId       String
  type         TwoFactorMethodType
  secret       String
  label        String?
  enabled      Boolean             @default(true)
  verifiedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Branch {
  id                String             @id @default(uuid())
  businessId        String
  name              String
  slug              String             @unique
  description       String?
  phone             String?
  email             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  latitude          Float?
  longitude         Float?
  timezone          String             @default("America/Argentina/Buenos_Aires")
  openingHours      Json?
  logoUrl           String?
  themeSettings     Json?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  business         Business             @relation(fields: [businessId], references: [id])
  staffAssignments BranchStaff[]
  services         Service[]
  categories       ServiceCategory[]
  customers        Customer[]
  bookings         Booking[]
  metrics          BranchMetric[]
  contentBlocks    BranchContentBlock[]
  testimonials     Testimonial[]
}

model BranchStaff {
  id           String       @id @default(uuid())
  branchId     String
  userId       String
  status       String       @default("active")
  role         String?      @default("staff")
  hiredAt      DateTime?    @default(now())
  terminatedAt DateTime?
  notes        String?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schedules     StaffScheduleTemplate[]
  timeOff       StaffTimeOff[]
  assignments   StaffAssignment[]
  bookings      BookingStaff[]
  ratings       StaffRating[]

  @@unique([branchId, userId])
}

model StaffAssignment {
  id            String             @id @default(uuid())
  branchStaffId String
  serviceId     String
  type          StaffAssignmentType @default(PRIMARY)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  branchStaff BranchStaff @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchStaffId, serviceId])
}

model StaffScheduleTemplate {
  id            String          @id @default(uuid())
  branchStaffId String
  dayOfWeek     ScheduleDayOfWeek
  startTime     DateTime
  endTime       DateTime
  breaks        Json?
  capacity      Int?            @default(1)
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  branchStaff BranchStaff @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)

  history StaffScheduleHistory[]

  @@index([branchStaffId, dayOfWeek])
}

model StaffScheduleHistory {
  id             String                @id @default(uuid())
  templateId     String
  appliedOn      DateTime              @default(now())
  changeSummary  String?
  previousConfig Json?
  newConfig      Json
  appliedById    String?

  template  StaffScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  appliedBy User?                 @relation(fields: [appliedById], references: [id])
}

model StaffTimeOff {
  id            String   @id @default(uuid())
  branchStaffId String
  startsAt      DateTime
  endsAt        DateTime
  reason        String?
  approvedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branchStaff BranchStaff @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)
  approvedBy  User?       @relation(fields: [approvedById], references: [id])
}

model ServiceCategory {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?
  color       String?
  order       Int? @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([branchId, name])
}

model Service {
  id             String   @id @default(uuid())
  branchId       String
  categoryId     String?
  name           String
  description    String?
  durationMinutes Int
  priceCents     Int
  currency       String @default("ARS")
  requiresDeposit Boolean @default(false)
  depositCents   Int?   @default(0)
  isActive       Boolean @default(true)
  notes          String?
  order          Int?    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch   Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id])
  assignments StaffAssignment[]
  bookingServices BookingService[]
}

model Customer {
  id            String   @id @default(uuid())
  branchId      String
  externalId    String?
  firstName     String
  lastName      String?
  fullName      String?
  email         String?
  phone         String?
  instagram     String?
  notes         String?
  birthday      DateTime?
  marketingOptIn Boolean @default(false)
  tags          String[]
  lastVisitAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookings Booking[]
  ratings  StaffRating[]

  @@index([branchId, email])
  @@index([branchId, phone])
}

model Booking {
  id               String         @id @default(uuid())
  branchId         String
  customerId       String
  createdById      String?
  status           BookingStatus  @default(PENDING)
  source           BookingSource  @default(PUBLIC_SITE)
  scheduledDate    DateTime
  scheduledEnd     DateTime
  totalPriceCents  Int            @default(0)
  currency         String         @default("ARS")
  notes            String?
  internalNotes    String?
  reminderSentAt   DateTime?
  checkInAt        DateTime?
  checkOutAt       DateTime?
  cancelledAt      DateTime?
  reasonCanceled   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id])
  createdBy  User?          @relation("BookingCreator", fields: [createdById], references: [id])
  staff      BookingStaff[]
  services   BookingService[]
  payments   Payment[]
  audits     BookingAudit[]
  reminders  BookingReminder[]
}

model BookingStaff {
  id            String   @id @default(uuid())
  bookingId     String
  branchStaffId String
  assignedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  branchStaff BranchStaff @relation(fields: [branchStaffId], references: [id])
  assignedBy  User?       @relation(fields: [assignedById], references: [id])

  @@unique([bookingId, branchStaffId])
}

model BookingService {
  id           String   @id @default(uuid())
  bookingId    String
  serviceId    String?
  nameSnapshot String
  priceCents   Int
  durationMinutes Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod @default(CASH)
  amountCents     Int
  currency        String        @default("ARS")
  transactionId   String?
  metadata        Json?
  paidAt          DateTime?
  dueAt           DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model BookingAudit {
  id         String        @id @default(uuid())
  bookingId  String
  userId     String?
  action     String
  previous   Json?
  current    Json?
  metadata   Json?
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([bookingId])
}

model BookingReminder {
  id         String    @id @default(uuid())
  bookingId  String
  channel    String
  sentAt     DateTime
  status     String
  metadata   Json?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model StaffRating {
  id         String   @id @default(uuid())
  branchStaffId String
  customerId String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  branchStaff BranchStaff @relation(fields: [branchStaffId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id])
}

model BranchMetric {
  id          String          @id @default(uuid())
  branchId    String
  businessId  String
  periodType  MetricPeriodType
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  events BranchMetricEvent[]

  @@index([branchId, periodType, periodStart])
}

model BranchMetricEvent {
  id          String     @id @default(uuid())
  branchMetricId String
  metricName  MetricName
  value       Float
  metadata    Json?
  occurredAt  DateTime @default(now())

  branchMetric BranchMetric @relation(fields: [branchMetricId], references: [id], onDelete: Cascade)
}

model BranchContentBlock {
  id           String                @id @default(uuid())
  branchId     String
  type         ContentBlockType
  audience     BranchContentAudience @default(PUBLIC)
  status       ContentBlockStatus    @default(DRAFT)
  currentVersionId String?
  order        Int?                   @default(0)
  publishedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  versions     BranchContentBlockVersion[]
  currentVersion BranchContentBlockVersion? @relation("ContentCurrentVersion", fields: [currentVersionId], references: [id])

  testimonials Testimonial[]
}

model BranchContentBlockVersion {
  id          String                     @id @default(uuid())
  blockId     String
  title       String?
  subtitle    String?
  description String?
  mediaUrl    String?
  ctaLabel    String?
  ctaUrl      String?
  metadata    Json?
  status      ContentBlockVersionStatus @default(DRAFT)
  createdById String?
  publishedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  block       BranchContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("ContentBlockCreatedBy", fields: [createdById], references: [id])
  publishedBy User?              @relation("ContentBlockPublishedBy", fields: [publishedById], references: [id])
}

model Testimonial {
  id            String   @id @default(uuid())
  branchId      String
  contentBlockId String?
  customerName  String
  customerTitle String?
  initials      String?
  comment       String
  rating        Int?
  serviceName   String?
  displayOrder  Int?      @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  contentBlock BranchContentBlock? @relation(fields: [contentBlockId], references: [id])
}

model PlanChangeLog {
  id          String   @id @default(uuid())
  businessId  String
  previousPlanId String?
  newPlanId   String
  changedById String?
  reason      String?
  effectiveAt DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  previousPlan Plan?   @relation("PrevPlan", fields: [previousPlanId], references: [id])
  newPlan      Plan    @relation("NewPlan", fields: [newPlanId], references: [id])
  changedBy    User?   @relation(fields: [changedById], references: [id])
}

model FeatureToggle {
  id          String   @id @default(uuid())
  businessId  String
  key         String
  enabled     Boolean @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
}

model NotificationPreference {
  id          String   @id @default(uuid())
  userId      String
  channel     String
  enabled     Boolean @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
}

model BookingWaitlist {
  id          String   @id @default(uuid())
  branchId    String
  customerId  String?
  name        String
  phone       String
  preferredServiceId String?
  preferredDate DateTime?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  preferredService Service? @relation(fields: [preferredServiceId], references: [id])
}

model Integration {
  id          String   @id @default(uuid())
  businessId  String
  provider    String
  config      Json
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  branchId   String?
  userId     String?
  entity     String
  entityId   String
  action     String
  changes    Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
}
